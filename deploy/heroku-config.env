# Non-secret config vars for Heroku app `pr-agent-app`, applied by the deploy workflow before each release.
# Format: KEY=VALUE, one per line, value is taken literally (no shell quoting; JSON values as-is). '#' starts a comment line.
# NEVER put secrets here (tokens, keys, passwords, webhook/session secrets). Set those in Heroku out-of-band.
# The workflow only sets/updates the keys listed here; it never unsets vars that are missing from this file.
# Seeded from docs and configuration.toml defaults: verify against `heroku config -a pr-agent-app` on first run.

GITHUB_APP__AUTHOR_CLAUDE_TOKENS=true
GITHUB_APP__AUTHOR_CLAUDE_MODEL=claude-sonnet-4-6
GITHUB_APP__AUTHOR_CHATGPT_PLAN_MODEL=gpt-5.6-sol
GITHUB_APP__PR_COMMANDS=["/review"]
GITHUB_APP__HANDLE_PUSH_TRIGGER=true
GITHUB_APP__PUSH_COMMANDS=["/review"]
GITHUB_APP__REQUESTER_DELEGATING_BOTS=["dbarnacle-bots-de-kalo[bot]"]
CONFIG__DEPLOYMENT_TYPE=app
GIT_PYTHON_REFRESH=quiet
